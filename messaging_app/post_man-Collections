{
  "info": {
    "name": "MessagingAppAPI",
    "_postman_id": "unique-id",
    "description": "Tests for Messaging App API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Get Token - airbnb_user",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\"username\": \"{{username_airbnb}}\", \"password\": \"{{password_airbnb}}\"}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{base_url}}/api/token/"
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Response has access and refresh tokens\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.access).to.be.a(\"string\");",
              "    pm.expect(jsonData.refresh).to.be.a(\"string\");",
              "    pm.environment.set(\"access_token_airbnb\", jsonData.access);",
              "    pm.environment.set(\"refresh_token_airbnb\", jsonData.refresh);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Get Token - user3",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\"username\": \"{{username_user3}}\", \"password\": \"{{password_user3}}\"}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{base_url}}/api/token/"
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Response has access and refresh tokens\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.access).to.be.a(\"string\");",
              "    pm.expect(jsonData.refresh).to.be.a(\"string\");",
